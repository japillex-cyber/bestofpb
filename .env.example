# ─────────────────────────────────────────────
# DATABASE (Supabase)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ─────────────────────────────────────────────
# NEXTAUTH
# ─────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-run-openssl-rand-base64-32"

# ─────────────────────────────────────────────
# GOOGLE OAUTH
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─────────────────────────────────────────────
# FACEBOOK OAUTH
# ─────────────────────────────────────────────
FACEBOOK_CLIENT_ID="your-facebook-app-id"
FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"

# ─────────────────────────────────────────────
# STRIPE
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Membership plan price IDs (create in Stripe dashboard)
STRIPE_REGULAR_MONTHLY_PRICE_ID="price_..."
STRIPE_REGULAR_YEARLY_PRICE_ID="price_..."
STRIPE_VIP_MONTHLY_PRICE_ID="price_..."
STRIPE_VIP_YEARLY_PRICE_ID="price_..."

# Vendor subscription price IDs
STRIPE_VENDOR_BASIC_PRICE_ID="price_..."
STRIPE_VENDOR_PRO_PRICE_ID="price_..."

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ─────────────────────────────────────────────
# STORAGE (Cloudinary or S3)
# ─────────────────────────────────────────────
# Option A: Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Option B: AWS S3
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION=""
# AWS_S3_BUCKET=""
